# 학교 서버(lab.ches.es.kr)용 설정 견본입니다.
# 서버에서 이 파일을 /opt/lantern/outputs/code/.env 로 복사한 뒤 비밀번호만 직접 적으세요. (DEPLOY.md 3단계)
# 이 견본에는 비밀 값이 없습니다. 실제 .env 는 git 에 올라가지 않습니다.

# 선생님 비밀번호 — 선생님이 직접 적기 (영문·숫자 섞어 10자 이상 권장, 띄어쓰기·따옴표·$·\ 는 쓰지 마세요)
# 비워 두면 선생님 페이지에서 방을 만들 수 없습니다.
TEACHER_PASSWORD=

# 게임 서버 포트 (nginx 조각의 127.0.0.1:3100 과 같아야 합니다)
PORT=3100

# 같은 컴퓨터(nginx)에서만 접속 가능하게 엽니다. 바꾸지 마세요.
HOST=127.0.0.1

# 주소 앞부분: https://lab.ches.es.kr/lantern/
BASE_PATH=/lantern

# nginx 가 넘겨 주는 학생 컴퓨터 주소(X-Forwarded-For)를 믿습니다. HOST=127.0.0.1 과 꼭 같이 씁니다.
TRUST_PROXY=1
