# 학교 서버(lab.ches.es.kr)용 설정 견본입니다.
# 서버에서 이 파일을 /opt/lantern/outputs/code/.env 로 복사하면 끝입니다. 고칠 것은 없습니다. (DEPLOY.md 3단계)
# 이 견본에는 비밀 값이 없습니다. 실제 .env 는 git 에 올라가지 않습니다.

# 선생님 비밀번호 — 비우면 비밀번호 없음 (기본 운영: 선생님 주소에서 누구나 '방 만들기' 버튼으로 방을 만듦)
# 값을 적으면 선생님 화면에 비밀번호 칸이 생기고 방을 만들 때 비밀번호를 물어요 (선택 기능. 띄어쓰기·따옴표·$·\ 는 쓰지 마세요)
TEACHER_PASSWORD=

# ── 방 수 제한 (서버 보호). 비워 두거나 줄을 지우면 괄호 안 기본값을 씁니다 ──
# 서버 전체에서 동시에 열 수 있는 방 (기본 40). 넘으면 "지금은 방이 꽉 찼어요. 잠시 뒤 다시 해 주세요"
MAX_ROOMS=40
# 같은 접속 주소(IP)가 동시에 가질 수 있는 방 (기본 8). 한 학교 선생님들은 같은 주소를 쓸 수 있어 넉넉하게 둡니다.
MAX_ROOMS_PER_IP=8
# 같은 접속 주소가 1시간에 만들 수 있는 방 (기본 20). 연타는 따로 1초에 1번으로 막습니다.
ROOM_CREATE_PER_HOUR=20
# 방 자동 정리 (분): 선생님 연결이 끊긴 채 이만큼 지나면 (기본 30) / 아무 활동 없이 이만큼 지나면 (기본 120) 방을 닫고 학생에게 알립니다.
# 그 전에 선생님이 새로고침·재접속하면 방을 그대로 이어받습니다.
ROOM_TEACHER_GONE_MINUTES=30
ROOM_IDLE_MINUTES=120

# 게임 서버 포트 (nginx 조각의 127.0.0.1:3600 과 같아야 합니다)
PORT=3600

# 같은 컴퓨터(nginx)에서만 접속 가능하게 엽니다. 바꾸지 마세요.
HOST=127.0.0.1

# 주소 앞부분: https://lab.ches.es.kr/lantern/
BASE_PATH=/lantern

# nginx 가 넘겨 주는 학생 컴퓨터 주소(X-Forwarded-For)를 믿습니다. HOST=127.0.0.1 과 꼭 같이 씁니다.
TRUST_PROXY=1
