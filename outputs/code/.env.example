# 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 직접 적으세요. (.env 는 git 에 올리지 않습니다)

# 선생님 비밀번호 — 비우면 비밀번호 없음 (기본: 선생님 페이지에서 누구나 '방 만들기' 버튼으로 방을 만듦).
# 값을 적으면 방을 만들 때 비밀번호를 물어요 (선택 기능).
TEACHER_PASSWORD=

# 방 수 제한 (서버 보호). 비워 두면 괄호 안 기본값.
# MAX_ROOMS: 서버 전체 동시 방 (40) · MAX_ROOMS_PER_IP: 같은 접속 주소 동시 방 (8) · ROOM_CREATE_PER_HOUR: 같은 주소 1시간 방 만들기 (20)
MAX_ROOMS=
MAX_ROOMS_PER_IP=
ROOM_CREATE_PER_HOUR=
# 방 자동 정리 (분): 선생님 연결이 끊긴 채 (30) / 아무 활동 없이 (120) 지나면 방을 닫음
ROOM_TEACHER_GONE_MINUTES=
ROOM_IDLE_MINUTES=

# 서버 포트 (기본 3000)
PORT=3000

# 서버를 열 주소. 비워 두면 0.0.0.0 (같은 와이파이의 다른 기기에서도 접속 가능, 개발용).
# 학교 서버처럼 nginx 뒤에 둘 때는 127.0.0.1 (같은 컴퓨터 안에서만 접속) — deploy/.env.production.example 참고.
HOST=

# 앞에 nginx 같은 프록시(주소를 넘겨 주는 웹서버)가 있을 때만 1.
# 켜면 X-Forwarded-For 의 첫 값을 접속 주소로 써서 주소별 방 제한(·비밀번호 잠금)이 기기마다 따로 걸립니다.
# 이 헤더는 누구나 꾸밀 수 있으므로 켤 때는 반드시 HOST=127.0.0.1 과 같이 씁니다. 개발용은 비워 둡니다.
TRUST_PROXY=

# 주소 앞부분. 학교 서버의 https://lab.ches.es.kr/lantern 처럼 주소 뒤에 붙은 경로 아래에서 열 때 적습니다.
#  - 예: BASE_PATH=/lantern  → 화면 https://주소/lantern/ , 실시간 통신(웹소켓) wss://주소/lantern/ws
#  - 비워 두면 루트(http://localhost:3000/)에서 엽니다 (개발용 기본값).
#  - 값을 적어도 앞부분 없는 주소(/, /ws)는 계속 받습니다. 그래서 리버스 프록시(앞에서 주소를 넘겨 주는 웹서버)가
#    /lantern 을 떼고 넘기든 그대로 넘기든 둘 다 동작합니다. /lantern 으로 오면 /lantern/ 으로 다시 보냅니다.
BASE_PATH=
